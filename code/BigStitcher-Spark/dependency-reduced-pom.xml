  <modelVersion>4.0.0</modelVersion>
  <groupId>net.preibisch</groupId>
  <artifactId>BigStitcher-Spark</artifactId>
  <name>BigStitcher Spark</name>
  <version>0.1.0-SNAPSHOT</version>
