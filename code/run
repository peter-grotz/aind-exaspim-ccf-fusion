
#!/usr/bin/env bash
set -ex


 # Get the bigstitcher XML path from the manifest.
json_path="../data/exaspim_manifest1.json"
path=$(jq -r '."zarr_multiscale"."input_uri"' "$json_path")
in_base="${path%%/fusion/*}"   # input asset base
out_base="${in_base}"          # write outputs alongside the input asset
s3_xml_path="${in_base}/tile_alignment/ch_ccf_xmls/bigstitcher_split_affine_ch_ccf.xml"

# Set output zarr location
 zarr_location="${out_base}/fusion/fused_ccf_ch.zarr"

 job_name=$(echo "$s3_xml_path" | awk -F'/' '{print $4}')

 fusion_start=$(date -u +%Y-%m-%dT%H:%M:%SZ)

 echo "$job_name"


 #--------------------------------#
 log_file=/results/emr_affine_fusion.txt
 echo "processed_data_asset=${processed_data_asset}" >> $log_file
 echo "job_name=${job_name}" >> $log_file
 echo "s3_xml_path=${s3_xml_path}" >> $log_file
 echo "out_s3_bucket=${out_s3_bucket}" >> $log_file
 echo "zarr_location=${zarr_location}" >> $log_file
 echo "xml_out=${xml_out}" >> $log_file


 #--------------------------------#
 # Derive a mask BigStitcher XML from the CCF-channel XML by repointing only the
 # image-loader base path to the mask tiles (.../mask/SPIM.ome.zarr/). All
 # transforms are preserved, so the mask fuses into the same space as the CCF
 # channel. fused_mask_ch.zarr is a registration-only intermediate, not a
 # published channel.
 #--------------------------------#
 mask_xml_local=/results/bigstitcher_split_affine_mask.xml
 mask_xml_s3="${out_base}/fusion/bigstitcher_split_affine_mask.xml"
 mask_zarr_location="${out_base}/fusion/fused_mask_ch.zarr"
 aws s3 cp "${s3_xml_path}" "${mask_xml_local}"
 sed -i 's#/flatfield_correction/SPIM.ome.zarr/#/flatfield_correction/mask/SPIM.ome.zarr/#g' "${mask_xml_local}"
 aws s3 cp "${mask_xml_local}" "${mask_xml_s3}"
 echo "mask_xml_s3=${mask_xml_s3}" >> $log_file
 echo "mask_zarr_location=${mask_zarr_location}" >> $log_file


 #--------------------------------#
 #--------------------------------#
 #--------------------------------#

 # Build the fusion containers for the CCF channel and the mask.
sh /code/BigStitcher-Spark_March2025/create-fusion-container-fromfatjar \
  -x "${s3_xml_path}" \
  -o "${zarr_location}" \
  -d UINT16 \
  --multiRes \
  --blockSize 256,256,256 \
  -s ZARR \
  --anisotropyFactor 1

sh /code/BigStitcher-Spark_March2025/create-fusion-container-fromfatjar \
  -x "${mask_xml_s3}" \
  -o "${mask_zarr_location}" \
  -d UINT16 \
  --multiRes \
  --blockSize 256,256,256 \
  -s ZARR \
  --anisotropyFactor 1


 # 1) Create application
 create_app=$(aws emr-serverless create-application \
   --region us-west-2 \
   --type SPARK \
   --name $job_name \
   --release-label "emr-6.15.0" \
   --architecture X86_64 \
   --initial-capacity '{
     "DRIVER": {
       "workerCount": 1,
       "workerConfiguration": {
         "cpu": "1vCPU",
         "memory": "5GB"
       }
     },
     "EXECUTOR": {
       "workerCount": 5,
       "workerConfiguration": {
         "cpu": "16vCPU",
         "memory": "32GB"
       }
     }
   }' \
   --maximum-capacity '{
     "cpu": "1000vCPU",
     "memory": "7500GB",
     "disk": "100000GB"
   }')

 APPLICATION_ID=$(echo $create_app | /usr/bin/jq --raw-output '.applicationId')
 echo "My application's ID: $APPLICATION_ID"
 #
 # Wait until the application is created, then start it.
 until [ "$app_state" = "CREATED" ];
 do
     get_state=$(aws emr-serverless get-application \
             --region us-west-2 \
             --application-id $APPLICATION_ID)
     app_state=$(echo $get_state | /usr/bin/jq --raw-output '.application.state')
     echo $app_state
 done
 aws emr-serverless start-application \
     --region us-west-2 \
     --application-id $APPLICATION_ID
 echo "Job Started"


 # 2) Run the CCF channel fusion.
 JOB_ROLE_ARN="arn:aws:iam::467914378000:role/aind-emr-role"
 # JOB_ROLE_ARN="arn:aws:iam::467914378000:role/aind-codeocean-power-user"

 # entryPointArguments must be a list, one element per token.
 run_job=$(aws emr-serverless start-job-run \
     --region us-west-2 \
     --application-id $APPLICATION_ID \
     --execution-role-arn $JOB_ROLE_ARN \
     --name $job_name \
     --job-driver '{
         "sparkSubmit": {
             "entryPoint": "s3://aind-scratch-data/sharmi.seshamani/BigStitcher-Spark-0.1.0-SNAPSHOT_09-04-25.jar",
             "entryPointArguments": ["--blockScale","4,4,4",  "-o", "'"${zarr_location}"'", "-s", "ZARR"],
             "sparkSubmitParameters": "--class net.preibisch.bigstitcher.spark.SparkAffineFusion --conf spark.default.parallelism=120 --conf spark.driver.cores=1 --conf spark.driver.memory=6g --conf spark.executor.cores=16 --conf spark.executor.memory=53g --conf spark.emr-serverless.memoryOverheadFactor=0.12  --conf spark.executorEnv.REGION=us-west-2 --conf spark.emr-serverless.driverEnv.REGION=us-west-2 --conf spark.task.maxFailures=100 --conf spark.speculation=false  --conf spark.speculation.multiplier=1.5  --conf spark.speculation.quantile=0.75 --conf spark.hadoop.fs.s3a.multipart.size=134217728 --conf spark.excludeOnFailure.task.maxTaskAttemptsPerNode=1 --conf spark.dynamicAllocation.initialExecutors=2 --conf spark.hadoop.fs.s3a.connection.maximum=500 --conf spark.hadoop.fs.s3a.threads.max=512 --conf spark.hadoop.fs.s3a.retry.limit=20 --conf spark.hadoop.fs.s3a.retry.interval=500ms --conf spark.hadoop.fs.s3a.fast.upload=true --conf spark.hadoop.hive.metastore.client.factory.class=com.amazonaws.glue.catalog.metastore.AWSGlueDataCatalogHiveClientFactory"
         }
     }' \
     --configuration-overrides '{
         "monitoringConfiguration": {
             "s3MonitoringConfiguration": {
                 "logUri": "s3://aind-scratch-data/jonathan.wong/dask-emr/logs/"
             }
         }
     }' \
     --execution-timeout-minutes 14400
     )

 JOB_RUN_ID=$(echo $run_job | /usr/bin/jq --raw-output '.jobRunId')

 # Submit the mask fusion concurrently on the same EMR application.
 # Output -> fused_mask_ch.zarr.
 mask_job=$(aws emr-serverless start-job-run \
     --region us-west-2 \
     --application-id $APPLICATION_ID \
     --execution-role-arn $JOB_ROLE_ARN \
     --name "${job_name}_mask" \
     --job-driver '{
         "sparkSubmit": {
             "entryPoint": "s3://aind-scratch-data/sharmi.seshamani/BigStitcher-Spark-0.1.0-SNAPSHOT_09-04-25.jar",
             "entryPointArguments": ["--blockScale","4,4,4",  "-o", "'"${mask_zarr_location}"'", "-s", "ZARR"],
             "sparkSubmitParameters": "--class net.preibisch.bigstitcher.spark.SparkAffineFusion --conf spark.default.parallelism=120 --conf spark.driver.cores=1 --conf spark.driver.memory=6g --conf spark.executor.cores=16 --conf spark.executor.memory=53g --conf spark.emr-serverless.memoryOverheadFactor=0.12  --conf spark.executorEnv.REGION=us-west-2 --conf spark.emr-serverless.driverEnv.REGION=us-west-2 --conf spark.task.maxFailures=100 --conf spark.speculation=false  --conf spark.speculation.multiplier=1.5  --conf spark.speculation.quantile=0.75 --conf spark.hadoop.fs.s3a.multipart.size=134217728 --conf spark.excludeOnFailure.task.maxTaskAttemptsPerNode=1 --conf spark.dynamicAllocation.initialExecutors=2 --conf spark.hadoop.fs.s3a.connection.maximum=500 --conf spark.hadoop.fs.s3a.threads.max=512 --conf spark.hadoop.fs.s3a.retry.limit=20 --conf spark.hadoop.fs.s3a.retry.interval=500ms --conf spark.hadoop.fs.s3a.fast.upload=true --conf spark.hadoop.hive.metastore.client.factory.class=com.amazonaws.glue.catalog.metastore.AWSGlueDataCatalogHiveClientFactory"
         }
     }' \
     --configuration-overrides '{
         "monitoringConfiguration": {
             "s3MonitoringConfiguration": {
                 "logUri": "s3://aind-scratch-data/jonathan.wong/dask-emr/logs/"
             }
         }
     }' \
     --execution-timeout-minutes 14400
     )

 MASK_JOB_RUN_ID=$(echo $mask_job | /usr/bin/jq --raw-output '.jobRunId')

 # Poll both jobs until each reaches a terminal state.
 job_state=""
 mask_job_state=""
 until { [ "$job_state" = "SUCCESS" ] || [ "$job_state" = "FAILED" ]; } \
    && { [ "$mask_job_state" = "SUCCESS" ] || [ "$mask_job_state" = "FAILED" ]; };
 do
     sleep 10
     job_state=$(aws emr-serverless get-job-run --region us-west-2 --application-id $APPLICATION_ID --job-run-id $JOB_RUN_ID | /usr/bin/jq --raw-output '.jobRun.state')
     mask_job_state=$(aws emr-serverless get-job-run --region us-west-2 --application-id $APPLICATION_ID --job-run-id $MASK_JOB_RUN_ID | /usr/bin/jq --raw-output '.jobRun.state')
     echo "ccf=$job_state mask=$mask_job_state"
 done

 echo "CCF fusion: $job_state ; Mask fusion: $mask_job_state"

 # The CCF channel fusion is required: abort if it failed. The mask fusion is
 # optional, so its failure is only a warning.
 if [ "$job_state" != "SUCCESS" ]; then
     echo "ERROR: CCF channel fusion did not succeed (ccf=$job_state mask=$mask_job_state); aborting." >&2
     exit 1
 fi
 if [ "$mask_job_state" != "SUCCESS" ]; then
     echo "WARNING: mask fusion did not succeed (mask=$mask_job_state); continuing without the fused mask -- registration will run unmasked for this subject." >&2
     # The container was created up front, so a failed mask job leaves an empty
     # fused_mask_ch.zarr behind. Delete it (best-effort) so the mask is absent,
     # which signals registration to run unmasked.
     echo "Deleting empty/partial fused mask container: ${mask_zarr_location}" >&2
     aws s3 rm --recursive "${mask_zarr_location}/" || echo "  (mask container cleanup failed or nothing to remove; non-fatal)" >&2
 fi

 # Emit the process record. Pass the mask fusion status so processing.json
 # records whether the flat-field mask was fused.
 python emit_fusion_record.py "$fusion_start" "$mask_job_state" || echo "metadata emit failed (non-fatal)"

python update_smartsheet.py
echo "SmartSheet update step done -- CCF channel fusion SUCCESS (mask=$mask_job_state)"

 # (3) Clean up: stop and delete the application.
 #aws emr-serverless stop-application \
 #    --application-id $APPLICATION_ID

